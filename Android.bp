// SPDX-License-Identifier: Apache-2.0
soong_namespace {
}

cc_prebuilt_binary {
    name: "ims_bridged",
    owner: "sprd",
    system_ext_specific: true,
    compile_multilib: "64",
    arch: {
        arm64: {
            srcs: ["proprietary/system_ext/bin/ims_bridged"],
        },
    },
    init_rc: ["configs/init/ims_bridged.rc"],
    shared_libs: [
        "libnetutils",
        "liblog",
        "libcutils",
        "libnl",
        "libimsbrd",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    check_elf_files: true,
    strip: {
        none: true,
    },
}

cc_prebuilt_library_shared {
    name: "libimsbrd",
    owner: "sprd",
    system_ext_specific: true,
    compile_multilib: "64",
    arch: {
        arm64: {
            srcs: ["proprietary/system_ext/lib64/libimsbrd.so"],
        },
    },
    shared_libs: [
        "liblog",
        "libnetutils",
        "libcutils",
        "libnetlink",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    check_elf_files: true,
    strip: {
        none: true,
    },
}

android_app_import {
    name: "SprdImsService",
    owner: "sprd",
    apk: "proprietary/system_ext/priv-app/SprdImsService/SprdImsService.apk",
    certificate: "platform",
    privileged: true,
    system_ext_specific: true,
    overrides: ["ims"],
    dex_preopt: {
        enabled: false,
    },
}
